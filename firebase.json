{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [{
    "source": "functions",
    "codebase": "default",
    "runtime": "nodejs20"
  }],
  "hosting": {
    "public": "out",
    "rewrites": [{
      "source": "**",
      "run": {
        "serviceId": "nextjs-app",
        "region": "us-central1"
      }
    }],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}