  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "firebase:stage": "rm -rf functions/nextjs && mkdir -p functions/nextjs && cp -r .next/standalone/* functions/nextjs/ && mkdir -p functions/nextjs/.next && cp -r .next/* functions/nextjs/.next/ && cp -r public functions/nextjs/ && cp functions/fetch-patch.js functions/nextjs/fetch-patch.js",
    "build:mobile": "next build && npx cap sync",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "deploy:cloudrun": "gcloud builds submit --tag gcr.io/walking-challenge-cd6dd/nextjs-app && gcloud run deploy nextjs-app --image gcr.io/walking-challenge-cd6dd/nextjs-app --platform managed --region us-central1 --allow-unauthenticated && firebase deploy --only hosting"
  },
