<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Use the platform SplashScreen theme for API 31+ -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

    <!-- Provide a minimal Theme.SplashScreen fallback in case platform theme isn't available to AAPT -->
    <style name="Theme.SplashScreen" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">?android:colorBackground</item>
    </style>

</resources>
