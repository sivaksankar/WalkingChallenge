rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NextAuth collections (for OAuth state and session management)
    // Backend uses Firebase Admin SDK which bypasses auth rules, but we define them for client access
    match /accounts/{accountId} {
      allow read, write: if request.auth != null;
    }
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }
    match /verificationTokens/{tokenId} {
      allow read, write: if request.auth != null;
    }

    // Allow read access to all users for the leaderboard
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == resource.data.email;
      
      // Steps subcollection
      match /steps/{stepId} {
        allow read, write: if request.auth != null && request.auth.token.email == get(/databases/$(database)/documents/users/$(userId)).data.email;
      }
    }

    // Challenges collection
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.token.email == 'sivaksankar@gmail.com';
      allow update: if request.auth != null && 
                   (request.auth.token.email == 'sivaksankar@gmail.com' ||
                   request.resource.data.participants.hasAny([request.auth.token.email]));
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}